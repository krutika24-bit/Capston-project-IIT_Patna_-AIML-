# DuckDB databases (can be large, regenerated by scripts) 
data/*.duckdb 
 
# Raw CSV data (large, not tracked in git) 
data/raw/*.csv 
 
# Processed data 
data/processed/* 
 
# Python cache 
__pycache__/ 
*.pyc 
*.pyo 
 
# IDE / editor 
.vscode/ 
.idea/ 
*.swp 
*.swo 
 
# OS files 
.DS_Store 
Thumbs.db
